{
  "name": "frontend-iot",
  "version": "1.0.0",
  "description": "IOT Manufacturing Dashboard",
  "author": "STM CNC",
  "main": "electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "electron:dev": "ng build --configuration development && electron .",
    "package:win": "ng build --configuration production && electron-builder --win --x64",
    "package:mac": "ng build --configuration production && electron-builder --mac",
    "package:all": "ng build --configuration production && electron-builder --win --x64 --mac"
  },
  "build": {
    "appId": "com.stmcnc.iotdashboard",
    "productName": "IOT Dashboard",
    "copyright": "Copyright © 2025 STM CNC",
    "directories": {
      "output": "electron-dist"
    },
    "files": [
      "electron/**/*",
      "dist/FrontendIOT/browser/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IOT Dashboard"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.business"
    },
    "dmg": {
      "title": "IOT Dashboard ${version}",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/cdk": "~21.1.3",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/material": "~21.1.3",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "angular-fusioncharts": "^4.2.0",
    "apexcharts": "^5.10.4",
    "highcharts": "^12.5.0",
    "highcharts-angular": "^5.4.0",
    "jwt-decode": "^4.0.0",
    "lucide-angular": "^0.563.0",
    "ng-apexcharts": "^2.3.0",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.3",
    "@angular/cli": "^21.1.3",
    "@angular/compiler-cli": "^21.1.0",
    "@angular/material": "^21.1.3",
    "@playwright/test": "^1.59.1",
    "autoprefixer": "^10.4.24",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
