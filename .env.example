# MQTT ingestion service (pms-backend) — every variable the code reads.
# Copy to .env on the ingestion server. Never commit the real .env.

# Postgres — the collector's own, narrow user (machine_api_user in production;
# migration 038 limits it to what the collector does)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=iot
DB_USER=machine_api_user
DB_PASSWORD=change-me

# Redis — live state and the channel to the API
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# Broker. Keep the client id stable: the broker keeps this subscriber's
# messages while it restarts only for the same id (persistent session).
MQTT_URL=mqtts://broker.example.com:8883
MQTT_USER=iot-collector
MQTT_PASS=
MQTT_CLIENT_ID=pms-ingest-0
#MQTT_CA_FILE=/etc/iot/certs/ca.crt
# For a confirmed same-host broker only (bind plain port to loopback).
# Production remote brokers must use mqtts://, even with this flag:
#MQTT_URL=mqtt://127.0.0.1:1883
#MQTT_ALLOW_INSECURE=true

# The journal: every accepted reading is written here before the database
# has it. Must be on a persistent disk, not /tmp.
JOURNAL_DIR=/opt/iot/pms-backend/data/journal
# Disk the journal may use while the database is unreachable (default 2048 MB
# ≈ 5 h at 100 readings/s); beyond it new readings are refused and counted.
#JOURNAL_MAX_MB=2048
#JOURNAL_FSYNC_MS=100
# QoS1 ACK always waits for an explicit fsync, independently of this background interval.
# Names this collector's position in ingest_checkpoint (default: MQTT_CLIENT_ID)
#COLLECTOR_ID=pms-ingest-0

# /health and /metrics
HEALTH_PORT=3001
# Time allowed to write what is waiting on stop (keep below pm2 kill_timeout)
#SHUTDOWN_TIMEOUT_MS=7000

#MQTT_LOG_DIR=./logs/mqtt
TZ=Asia/Kolkata
